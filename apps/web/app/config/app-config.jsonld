    {
      "@id": "field:title",
      "@type": "app:Field",
      "label": "Title",
      "valueType": "text",
      "icon": "lucide:type",
      "inputComponent": "ui:TextInput",
      "displayComponent": "ui:TextDisplay"
    },
    {
      "@id": "field:status",
      "@type": "app:Field",
      "label": "Status",
      "valueType": "select",
      "icon": "lucide:circle-dot",
      "inputComponent": "ui:SelectInput",
      "displayComponent": "ui:StatusBadge",
      "options": [
        {
          "value": "todo",
          "label": "To Do",
          "color": "gray"
        },
        {
          "value": "in_progress",
          "label": "In Progress",
          "color": "blue"
        },
        {
          "value": "done",
          "label": "Done",
          "color": "green"
        },
        {
          "value": "blocked",
          "label": "Blocked",
          "color": "red"
        }
      ]
    },
    {
      "@id": "field:dueDate",
      "@type": "app:Field",
      "label": "Due Date",
      "valueType": "date",
      "icon": "lucide:calendar",
      "inputComponent": "ui:DatePicker",
      "displayComponent": "ui:DateDisplay"
    },
    {
      "@id": "field:assignee",
      "@type": "app:Field",
      "label": "Assignee",
      "valueType": "relation",
      "icon": "lucide:user",
      "inputComponent": "ui:UserPicker",
      "displayComponent": "ui:UserAvatar"
    },
    {
      "@id": "field:priority",
      "@type": "app:Field",
      "label": "Priority",
      "valueType": "select",
      "icon": "lucide:signal",
      "inputComponent": "ui:SelectInput",
      "displayComponent": "ui:PriorityBadge",
      "options": [
        {
          "value": "low",
          "label": "Low",
          "color": "blue",
          "icon": "lucide:arrow-down-circle"
        },
        {
          "value": "medium",
          "label": "Medium",
          "color": "amber",
          "icon": "lucide:minus-circle"
        },
        {
          "value": "high",
          "label": "High",
          "color": "rose",
          "icon": "lucide:alert-circle"
        }
      ]
    },
    {
      "@id": "field:startDate",
      "@type": "app:Field",
      "label": "Start Date",
      "valueType": "date",
      "icon": "lucide:calendar",
      "inputComponent": "ui:DatePicker",
      "displayComponent": "ui:DateDisplay"
    },
    {
