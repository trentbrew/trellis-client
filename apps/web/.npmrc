# Prevent automatic minor/patch upgrades that might introduce bugs
save-exact=true

# Hoist Vite and Rollup to prevent type conflicts with global node_modules
public-hoist-pattern[]=*vite*
public-hoist-pattern[]=*rollup*

@tiptap-pro:registry=https://registry.tiptap.dev/
//registry.tiptap.dev/:_authToken=***REMOVED***
