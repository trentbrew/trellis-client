# Default recipe
default:
    @just --list

# Get port from JSON-LD graph
port := `jq -r '.["@graph"][] | select(.["@type"] == "app:Application") | .devPort // 4141' app/config/app-config.jsonld`

# Run the dev server on canonical port (kills any existing process on that port first)
run interval="60":
    @just clear
    -lsof -ti:{{port}} | xargs kill -9 2>/dev/null || true
    @echo "🚀 Starting v2 dev server on port {{port}} with auto-commit ({{interval}}s)..."
    pnpm dev & ../../.scripts/auto-commit.sh {{interval}}

# Validate deployment (lint, tests, route validation, build)
validate:
    @just clear
    pnpm lint
    pnpm test
    pnpm validate:routes
    pnpm build

# Build the app for production
build:
    @just clear
    pnpm build

# Deploy to Firebase Hosting (toolkit-ui-v2)
deploy: build
    firebase deploy --only hosting:v2

# Deploy without rebuilding (use existing .output)
deploy-only:
    firebase deploy --only hosting:v2

# Preview deployment (creates a preview channel)
preview: build
    firebase hosting:channel:deploy preview --only v2

# Show Firebase hosting targets
targets:
    firebase target:apply hosting v2 toolkit-ui-v2

# Clear Nuxt cache
clear:
    rm -rf .nuxt
