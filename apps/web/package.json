  "scripts": {
    "build": "nuxt build",
    "clean": "rm -rf .nuxt dist node_modules package-lock.json && pnpm install",
    "dev": "node scripts/dev-safe.mjs",
    "preinstall": "node -e \"const ua=process.env.npm_config_user_agent||''; if(!ua.includes('pnpm')){console.error('This repo uses pnpm. Run: corepack enable && pnpm install'); process.exit(1)}\"",
    "format": "prettier --write .",
    "generate": "nuxt generate",
    "postinstall": "nuxt prepare",
    "lint": "eslint . --ignore-pattern '.archive/**' --ignore-pattern '.backups/**' --ignore-pattern '.gemini/**'",
    "lint:fix": "eslint . --fix --ignore-pattern '.archive/**' --ignore-pattern '.backups/**' --ignore-pattern '.gemini/**'",
    "maintenance:repair-users": "tsx scripts/maintenance-repair-users.ts",
    "seed:demo": "tsx scripts/seed-demo-data.ts",
    "typecheck": "nuxi typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:smoke:agent": "tsx scripts/smoke-test-agent.ts",
    "test:smoke:agent:pure": "tsx scripts/smoke-test-agent.ts --skip-network",
    "smoke:ws": "node scripts/smoke-ws.mjs",
    "smoke:sidecar": "node scripts/smoke-sidecar.mjs",
    "check": "pnpm lint && vitest run && tsx scripts/validate-routes.ts",
    "check:full": "pnpm lint && vitest run && tsx scripts/validate-routes.ts && nuxt build",
    "ui:add": "npx -y ui-thing@latest add",
    "preview": "nuxt preview",
    "validate:routes": "tsx scripts/validate-routes.ts",
    "generate:icons": "node scripts/generate-lucide-icons.mjs"
