{
  "name": "@toolkit/sandbox",
  "private": true,
  "author": {
    "name": "Behon Baker",
    "email": "behon.baker@yahoo.com",
    "url": "https://behonbaker.com"
  },
  "type": "module",
  "packageManager": "pnpm@10.8.0",
  "scripts": {
    "build": "nuxt build",
    "clean": "rm -rf .nuxt dist node_modules package-lock.json && pnpm install",
    "dev": "nuxt dev --port 4141",
    "preinstall": "node -e \"const ua=process.env.npm_config_user_agent||''; if(!ua.includes('pnpm')){console.error('This repo uses pnpm. Run: corepack enable && pnpm install'); process.exit(1)}\"",
    "format": "prettier --write .",
    "generate": "nuxt generate",
    "postinstall": "nuxt prepare",
    "lint": "eslint . --ignore-pattern '.archive/**' --ignore-pattern '.backups/**' --ignore-pattern '.gemini/**'",
    "lint:fix": "eslint . --fix --ignore-pattern '.archive/**' --ignore-pattern '.backups/**' --ignore-pattern '.gemini/**'",
    "maintenance:repair-users": "tsx scripts/maintenance-repair-users.ts",
    "seed:demo": "tsx scripts/seed-demo-data.ts",
    "typecheck": "nuxi typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "pnpm lint && vitest run && tsx scripts/validate-routes.ts",
    "check:full": "pnpm lint && vitest run && tsx scripts/validate-routes.ts && nuxt build",
    "ui:add": "npx -y ui-thing@latest add",
    "preview": "nuxt preview",
    "validate:routes": "tsx scripts/validate-routes.ts",
    "generate:icons": "node scripts/generate-lucide-icons.mjs"
  },
  "dependencies": {
    "@alcyone-labs/zod-to-json-schema": "4.0.10",
    "@guolao/vue-monaco-editor": "1.6.0",
    "@iconify-json/svg-spinners": "1.2.4",
    "@internationalized/date": "3.10.1",
    "@internationalized/number": "3.6.5",
    "@jspreadsheet-ce/vue": "5.0.1",
    "@nuxt/content": "3.11.0",
    "@nuxt/eslint": "^1.9.0",
    "@nuxt/fonts": "^0.11.4",
    "@nuxt/icon": "^2.0.0",
    "@nuxtjs/color-mode": "^3.5.2",
    "@pinia/nuxt": "^0.11.2",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/vite": "^4.1.12",
    "@tanstack/vue-table": "8.21.3",
    "@tiptap/starter-kit": "3.14.0",
    "@tiptap/vue-3": "3.14.0",
    "@toolkit/types": "workspace:*",
    "@toolkit/utils": "workspace:*",
    "@vee-validate/nuxt": "4.15.1",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.2",
    "@vue-flow/core": "^1.41.7",
    "@vue-flow/minimap": "^1.5.2",
    "@vue-flow/node-toolbar": "1.1.1",
    "@vueform/multiselect": "2.6.11",
    "@vueform/slider": "2.1.10",
    "@vueuse/nuxt": "^13.7.0",
    "@yuta-inoue-ph/nuxt-vcalendar": "1.1.4",
    "apexcharts": "5.3.6",
    "better-sqlite3": "12.6.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dayjs": "1.11.19",
    "embla-carousel": "8.6.0",
    "embla-carousel-vue": "8.6.0",
    "eslint": "^9.33.0",
    "jspreadsheet-ce": "5.0.4",
    "jsuites": "6.0.1",
    "jszip": "3.10.1",
    "lucide-static": "0.562.0",
    "lucide-vue-next": "0.562.0",
    "monaco-editor": "0.55.1",
    "motion-v": "^1.7.0",
    "nuxt": "4.1.2",
    "nuxt-og-image": "^5.1.9",
    "pdfjs-dist": "5.4.624",
    "pinia": "^3.0.3",
    "reka-ui": "^2.4.1",
    "tailwind-merge": "^3.3.1",
    "tailwind-variants": "^2.1.0",
    "tailwindcss": "^4.1.12",
    "vaul-vue": "0.4.1",
    "vue": "^3.5.19",
    "vue-currency-input": "3.2.2",
    "vue-router": "^4.5.1",
    "vue-sonner": "2.0.9",
    "vue3-apexcharts": "1.10.0",
    "vuedraggable": "4.1.0",
    "zod": "4.2.1"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.6.2",
    "@iconify-json/lucide": "^1.2.63",
    "@nuxt/test-utils": "^3.19.2",
    "@pinia/testing": "^1.0.2",
    "@playwright/test": "1.57.0",
    "@testing-library/vue": "^8.1.0",
    "@vue/test-utils": "^2.4.6",
    "happy-dom": "^18.0.1",
    "playwright-core": "^1.55.0",
    "postcss": "^8.5.4",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tsx": "^4.19.2",
    "tw-animate-css": "^1.3.7",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
