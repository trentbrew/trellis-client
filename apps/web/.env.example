# Nuxt runtime config (client-exposed)
TRELLIS_PORT=1414
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:1414/api/integrations/google-calendar/callback
GOOGLE_CALENDAR_WEBHOOK_SECRET=
GMAIL_REDIRECT_URI=http://localhost:1414/api/integrations/gmail/callback
GMAIL_WEBHOOK_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:1414/api/integrations/github/callback
GITHUB_WEBHOOK_SECRET=
CABLECAST_PROXY_URL=http://localhost:$TRELLIS_PORT/api
DEFAULT_TENANT=speakmpls

# Dev/test only. Never enable in production.
ENABLE_TEST_AUTH_BYPASS=false
ENABLE_CLOUD_DEV_LOGIN=false

# Data adapter mode: local (instant-local + TQL) or cloud (InstantDB)
TRELLIS_DATA_MODE=local

# InstantDB (required only for admin/seed scripts)
INSTANT_APP_ID=
INSTANT_SECRET=

# Optional: seed script helpers
SEED_USER_ID=
SEED_USER_EMAIL=

# Email (Resend) — optional, enables transactional emails (invites, notifications)
RESEND_API_KEY=
RESEND_FROM=Trellis <noreply@trellis.app>

# AI / LLM — Gemini (used for file metadata enrichment, workflows)
GEMINI_API_KEY=
# Ollama local model (fallback for entity enrichment — requires Ollama running locally)
OLLAMA_HOST=http://127.0.0.1:11434
TRELLIS_LLM_DEFAULT_MODEL=gemma4:e4b

# TokenRouter — intelligent LLM routing (powers the /home agent chat)
# Sign up + API keys: https://www.tokenrouter.com/console/token
# TokenRouter is OpenAI-compatible at /v1/chat/completions, so we use the openai SDK as a thin client.
TOKENROUTER_API_KEY=
TOKENROUTER_BASE_URL=https://api.tokenrouter.com/v1
# Leave TOKENROUTER_MODEL empty to enable the app-side classifier
# (lookups → Haiku, synthesis/reasoning → Sonnet, creative → Sonnet).
# Pin a specific model from the catalog (curl /v1/models with your key to see all):
#   TOKENROUTER_MODEL=anthropic/claude-sonnet-4.5
#   TOKENROUTER_MODEL=anthropic/claude-opus-4.7
#   TOKENROUTER_MODEL=claude-haiku-4-5
#   TOKENROUTER_MODEL=openai/gpt-5.2
TOKENROUTER_MODEL=
