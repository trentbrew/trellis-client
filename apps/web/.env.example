# Nuxt runtime config (client-exposed)
TRELLIS_PORT=1414
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:1414/api/integrations/google-calendar/callback
GOOGLE_CALENDAR_WEBHOOK_SECRET=
CABLECAST_PROXY_URL=http://localhost:$TRELLIS_PORT/api
DEFAULT_TENANT=speakmpls

# Dev/test only. Never enable in production.
ENABLE_TEST_AUTH_BYPASS=false

# InstantDB (required only for admin/seed scripts)
INSTANT_APP_ID=
INSTANT_SECRET=

# Optional: seed script helpers
SEED_USER_ID=
SEED_USER_EMAIL=

# Email (Resend) — optional, enables transactional emails (invites, notifications)
RESEND_API_KEY=
RESEND_FROM=Trellis <noreply@trellis.app>
