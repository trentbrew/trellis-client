{
  "name": "@turtle.tech/trellis-kernel",
  "version": "0.1.0",
  "private": true,
  "description": "Trellis kernel — EAV store, EQL-S query engine, graph mutations",
  "type": "module",
  "main": "./index.ts",
  "types": "./index.ts",
  "exports": {
    ".": {
      "types": "./index.ts",
      "import": "./index.ts"
    },
    "./store": {
      "types": "./store/eav-store.ts",
      "import": "./store/eav-store.ts"
    },
    "./kernel": {
      "types": "./kernel/trellis-kernel.ts",
      "import": "./kernel/trellis-kernel.ts"
    },
    "./persist": {
      "types": "./persist/backend.ts",
      "import": "./persist/backend.ts"
    },
    "./persist/jsonl": {
      "types": "./persist/jsonl-backend.ts",
      "import": "./persist/jsonl-backend.ts"
    },
    "./persist/better-sqlite": {
      "types": "./persist/better-sqlite-backend.ts",
      "import": "./persist/better-sqlite-backend.ts"
    },
    "./query": {
      "types": "./query/index.ts",
      "import": "./query/index.ts"
    },
    "./graph": {
      "types": "./graph/index.ts",
      "import": "./graph/index.ts"
    }
  },
  "files": [
    "**/*.ts"
  ],
  "dependencies": {
    "zod": "^4.2.1"
  },
  "peerDependencies": {
    "better-sqlite3": ">=11.0.0"
  },
  "peerDependenciesMeta": {
    "better-sqlite3": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "typescript": "^5.9.2"
  }
}
