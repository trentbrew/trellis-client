{
  "name": "trellis",
  "version": "0.1.0",
  "type": "module",
  "description": "Launch and manage a local Trellis knowledge graph workspace",
  "main": "./src/client.mjs",
  "bin": {
    "trellis": "./bin/trellis.mjs"
  },
  "exports": {
    ".": {
      "types": "./src/client.ts",
      "import": "./src/client.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin/",
    "src/",
    "web/"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm run build:web",
    "build:web": "node scripts/build-web.mjs",
    "prepack": "pnpm run build:web",
    "prepublishOnly": "pnpm run build:web"
  },
  "dependencies": {
    "better-sqlite3": "12.6.2"
  }
}
